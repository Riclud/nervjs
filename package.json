{
  "name": "nervjs",
  "scripts": {
    "start": "./scripts/start.sh ./scripts/cli.ts build && ./scripts/start.sh ./src/main.ts",
    "dev": "./scripts/start.sh ./scripts/cli.ts build && ./scripts/start.sh --watch ./src/main.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "nerv": "./scripts/start.sh ./scripts/cli.ts",
    "nerv:build": "./scripts/start.sh ./scripts/cli.ts build",
    "nerv:watch": "./scripts/start.sh ./scripts/cli.ts watch"
  },
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "prettier": "^3.9.9"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "zod": "^4"
  }
}
